# Copy this file to .env and fill in your keys.
# Keys marked OPTIONAL work without a value but will hit stricter rate limits.
# Keys marked REQUIRED must be set or that data source will return N/A.

# OPTIONAL — raises Semantic Scholar rate limit from 5 s/req to 2 s/req
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# REQUIRED for patent data (NPL rate, corporate patent share)
# Apply at: https://www.lens.org/lens/user/subscriptions#developer
LENS_API_KEY=

# REQUIRED for Product Hunt entrepreneurial demand data
# Create a developer token at: https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=
